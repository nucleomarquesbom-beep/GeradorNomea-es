# Optional: if the FPF changes its internal search endpoint, put the
# endpoint here. It must be an official FPF URL and accept ?q=CLUB_NAME.
#
# Example:
# FPF_CLUB_SEARCH_ENDPOINT=https://www.fpf.pt/...
#
# Leave empty to use the built-in FPF directory resolver.
FPF_CLUB_SEARCH_ENDPOINT=

# Optional cache duration in seconds.
FPF_CACHE_SECONDS=21600
